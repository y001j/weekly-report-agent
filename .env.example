# 复制本文件为 .env 并填入你的 Key；.env 不会被提交到 Git
MODEL_API_KEY=your-api-key

# 默认：MiniMax-M3.1-Flash，走 Anthropic 兼容接口（MiniMax 官方推荐）
MODEL_PROTOCOL=anthropic
MODEL_NAME=MiniMax-M3.1-Flash
MODEL_BASE_URL=https://api.minimax.cn/anthropic
# 海外账号用：https://api.minimax.io/anthropic

# 换成 DeepSeek 等 OpenAI 兼容模型：
# MODEL_PROTOCOL=openai
# MODEL_NAME=deepseek-chat
# MODEL_BASE_URL=https://api.deepseek.com

# EP03：长期记忆按用户隔离
USER_ID=rocky

# EP04：Langfuse 追踪（可选，不填则不上报）
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # 自部署填你自己的地址

# 提示词版本（v1 / v2 / v3），EP06起默认 v3
PROMPT_VERSION=v3

# EP07：发送与审批（不填则只在终端打印，方便本地演示）
# GROUP_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx     # 周报发到哪个群
# APPROVER_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/yyyy  # 审批通知发给谁
# APPROVAL_BASE_URL=https://approve.your-domain.com   # 审批网页的对外地址
APPROVAL_SECRET=change-me-to-a-long-random-string     # 审批链接签名密钥，务必修改
