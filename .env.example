# 复制本文件为 .env 并填入你的 Key；.env 不会被提交到 Git
MODEL_API_KEY=your-api-key

# 默认：MiniMax-M3.1-Flash，走 Anthropic 兼容接口（MiniMax 官方推荐）
MODEL_PROTOCOL=anthropic
MODEL_NAME=MiniMax-M3.1-Flash
MODEL_BASE_URL=https://api.minimax.cn/anthropic
# 海外账号用：https://api.minimax.io/anthropic

# 换成 DeepSeek 等 OpenAI 兼容模型：
# MODEL_PROTOCOL=openai
# MODEL_NAME=deepseek-chat
# MODEL_BASE_URL=https://api.deepseek.com

# EP03：长期记忆按用户隔离
USER_ID=rocky
